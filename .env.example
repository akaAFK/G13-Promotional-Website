# OpenRouter API key (free models are enough for the MVP)
OPENROUTER=sk-or-v1-...
OPENROUTER_API_KEY=sk-or-v1-...   # alternative name, either one works
OPENROUTER_MODEL=openrouter/free

# PostgreSQL (compose uses these defaults)
POSTGRES_USER=g13
POSTGRES_PASSWORD=g13
POSTGRES_DB=g13
DATABASE_URL=postgresql+psycopg://g13:g13@postgres:5432/g13

# Gmail via fastapi-mail: keep dev mode for the demo (messages go to backend logs)
MAIL_DEV_MODE=true
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=G13 Project
